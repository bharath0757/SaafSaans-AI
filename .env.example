# SaafSaans environment variables
# Copy to .env.local for local development. Never commit secrets.

# Optional LLM providers (app works without any key via rule-based planner)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Public site URL (used for absolute links / CSP reports later)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
